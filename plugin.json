{
  "apiVersion": 1,
  "activationScope": "global",
  "id": "modera.prompt-manager",
  "name": "System prompts",
  "version": "0.1.0",
  "category": "knowledge",
  "icon": "file",
  "description": "Edit the system prompt as a document, with source annotations for every plugin.",
  "locales": {
    "zh-CN": {
      "name": "系统提示词",
      "description": "像编辑文档一样调整系统提示词，点击正文查看插件来源。"
    }
  },
  "main": "dist/index.cjs",
  "permissions": [
    "prompts.read",
    "prompts.write",
    "storage.read",
    "storage.write"
  ],
  "frontends": { "settings": { "root": "dist/ui", "entry": "settings.html" } },
  "settings": {
    "title": "System prompts",
    "frontend": "settings",
    "waitForReady": true,
    "width": "wide",
    "locales": { "zh-CN": { "title": "系统提示词" } }
  },
  "extensions": ["settings"],
  "contributions": ["promptEditor"]
}
