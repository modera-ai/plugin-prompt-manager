{
  "title": "System prompts",
  "activationScope": "global",
  "category": "knowledge",
  "icon": "file",
  "locales": {
    "zh-CN": {
      "name": "系统提示词",
      "description": "像编辑文档一样调整系统提示词，点击正文查看插件来源。"
    }
  },
  "permissions": [
    "pal.prompts.read",
    "pal.storage.read"
  ],
  "frontends": {
    "settings": {
      "root": "dist/ui",
      "entry": "settings.html"
    }
  },
  "settings": {
    "title": "System prompts",
    "frontend": "settings",
    "waitForReady": true,
    "width": "wide",
    "locales": {
      "zh-CN": {
        "title": "系统提示词"
      }
    }
  },
  "extensions": [
    "pal.ui.settings"
  ],
  "contributions": [
    "promptEditor"
  ],
  "requiresHost": {
    "pal.command.callable": 1,
    "pal.command.dispatch": 1,
    "pal.context.command": 1,
    "pal.plugin.declarations": 1,
    "pal.command.settings": 1,
    "pal.context.promptDocuments.inspect": 1
  },
  "declarations": {
    "provides": {
      "commands": [
        {
          "id": "pal.prompt-manager.read",
          "title": "读取系统提示词",
          "visibility": "private",
          "readOnly": true,
          "requiredPermissions": [
            "pal.prompts.read",
            "pal.storage.read"
          ],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "enum": [
                  "global",
                  "project"
                ]
              }
            },
            "required": [
              "scope"
            ]
          }
        },
        {
          "id": "pal.prompt-manager.save",
          "title": "保存系统提示词覆盖",
          "visibility": "private",
          "readOnly": false,
          "requiredPermissions": [
            "pal.prompts.read",
            "pal.storage.read",
            "pal.prompts.write",
            "pal.storage.write"
          ],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "enum": [
                  "global",
                  "project"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "edits": {
                "type": "array",
                "maxItems": 80,
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "scope",
              "revision",
              "edits"
            ]
          }
        }
      ]
    },
    "consumes": {
      "commands": [
        {
          "id": "pal.frontend.context",
          "reason": "使用已声明前端的宿主能力"
        },
        {
          "id": "pal.frontend.open-settings",
          "reason": "使用已声明前端的宿主能力"
        },
        {
          "id": "pal.frontend.settings",
          "reason": "使用已声明前端的宿主能力"
        }
      ]
    }
  }
}
